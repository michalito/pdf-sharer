# PDF Sharer Environment Configuration
# Copy this file to .env and update values as needed

# Required in production: Secret key for session management
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: Database connection URL
# Defaults to SQLite at instance/pdfs.db if not set
# DATABASE_URL=sqlite:///instance/pdfs.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/pdf_sharer

# Optional: Upload folder path (default: uploads)
# UPLOAD_FOLDER=uploads

# Optional: Maximum upload size in bytes (default: 16MB)
# MAX_CONTENT_LENGTH=16777216

# Optional: Host port for Docker (default: 5001)
# Using 5001 to avoid macOS AirPlay conflict on port 5000
# HOST_PORT=5001

# Session Security (recommended for production)
# SESSION_COOKIE_SECURE=true  # Requires HTTPS

# Flask environment (development or production)
# FLASK_ENV=production
