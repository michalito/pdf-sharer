# saíta Environment Configuration
# Copy this file to .env and update values as needed

# Required in production: Secret key for session/cookie signing.
# Keep this stable across restarts/deploys so protected-item unlock sessions remain valid.
# deploy.sh will auto-generate one if not set.
# SECRET_KEY=change-me-to-a-long-random-value

# Optional: Database connection URL (SQLite only)
# Defaults to SQLite at instance/saita.db if not set
# Relative SQLite paths resolve under Flask's instance directory.
# DATABASE_URL=sqlite:///saita.db

# Optional: Upload folder path (default: uploads)
# UPLOAD_FOLDER=uploads

# Optional: Maximum upload size in bytes (default: 2GB)
# MAX_CONTENT_LENGTH=2147483648

# Optional: Maximum note body length in characters (default: 100000)
# MAX_NOTE_TEXT_LENGTH=100000

# Optional: Note excerpt size in list responses (default: 180, bounded 40..1000)
# NOTE_EXCERPT_LENGTH=180

# Optional: App version exposed by protected /api/app-info and shown in the UI footer
# If unset, deploy.sh auto-detects from latest git tag (fallback: dev)
# APP_VERSION=dev

# Optional: Host port for Docker (default: 5001)
# Using 5001 to avoid macOS AirPlay conflict on port 5000
# Named dev instances auto-select and persist a free port if this is unset.
# HOST_PORT=5001

# Optional: Dev frontend host port (default: 5173)
# Useful when running multiple worktrees side by side with ./deploy.sh dev
# Named dev instances auto-select and persist a free port if this is unset.
# FRONTEND_PORT=5173

# Optional: Number of trusted reverse-proxy hops for X-Forwarded-For (default: 0)
# Set to 1 when running behind a single reverse proxy
# TRUST_PROXY_HOPS=1

# Session Security (true in production; false in local development)
# Forward authentication requires HTTPS-only unlock cookies.
# SESSION_COOKIE_SECURE=true

# Production authentication: all of these are required, no production bypass mode.
# Local development defaults to AUTH_MODE=development and needs no IdP.
# AUTH_MODE=forward
# APP_ORIGIN=https://saita.home.theforceiswith.me
# AUTHENTIK_PROXY_ISSUER=https://auth.theforceiswith.me/application/o/saita/
# AUTHENTIK_PROXY_CLIENT_ID=<dedicated-saita-provider-client-id>
# AUTHENTIK_REQUIRED_GROUP=app-saita
# Dedicated Authentik proxy client secret in a backend-only file (at least 32 bytes).
# Keep out of Git; Kubernetes should mount it from a SealedSecret/Secret.
# Docker Compose: host path, mounted read-only at /run/authentik/saita-client-secret.
# Other runtimes: path visible inside the application container.
# Loaded once at startup. Restart workers after a controlled provider-secret rotation.
# AUTHENTIK_PROXY_CLIENT_SECRET_FILE=/private/absolute/path/to/saita-client-secret

# Production Compose binds only to loopback by default. An authenticated ingress
# must reach it; change deliberately when running a proxy on another host.
# HOST_BIND_ADDRESS=127.0.0.1

# Flask environment (development or production)
# FLASK_ENV=production
