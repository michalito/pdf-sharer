# File Sharer Environment Configuration
# Copy this file to .env and update values as needed

# Optional: Secret key for cookie signing.
# Authentication is not used, so this can be omitted (a random key is generated at startup).
# SECRET_KEY=change-me

# Optional: Database connection URL
# Defaults to SQLite at instance/sharer.db if not set
# DATABASE_URL=sqlite:///instance/sharer.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/file_sharer

# Optional: Upload folder path (default: uploads)
# UPLOAD_FOLDER=uploads

# Optional: Maximum upload size in bytes (default: 2GB)
# MAX_CONTENT_LENGTH=2147483648

# Optional: Host port for Docker (default: 5001)
# Using 5001 to avoid macOS AirPlay conflict on port 5000
# HOST_PORT=5001

# Session Security (recommended for production)
# SESSION_COOKIE_SECURE=true  # Requires HTTPS

# Flask environment (development or production)
# FLASK_ENV=production
