# CI-specific Dockerfile for ARM64 builds
# Skips the frontend-builder stage (frontend is pre-built natively by CI)
# and expects built assets already placed in app/templates/ and app/static/assets/

FROM python:3.12-slim-bookworm AS py-builder

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

FROM python:3.12-slim-bookworm

RUN useradd --create-home --shell /bin/bash app

ARG APP_VERSION=dev
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/home/app/.local/bin:$PATH" \
    FLASK_APP=run.py \
    APP_VERSION=${APP_VERSION}

WORKDIR /app

COPY --from=py-builder /root/.local /home/app/.local

COPY --chown=app:app . .

RUN mkdir -p /app/instance /app/uploads && \
    chown -R app:app /app/instance /app/uploads && \
    chmod +x /app/entrypoint.sh

USER app

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/api/health')" || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--threads", "4", "run:app"]
